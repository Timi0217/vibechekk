    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
