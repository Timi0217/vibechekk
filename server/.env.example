# Vibechekk Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Required: Security
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-base64-32

# Required: API Keys
GITHUB_API_TOKEN=your-github-token-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Required: Stripe
STRIPE_SECRET_KEY=sk_test_or_live_key_here
STRIPE_PRICE_ID=price_1SkDqDLd8BonO0ZWPrwvJDL1
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Enrichment Services
PDL_API_KEY=your-peopledatalabs-api-key
EXA_API_KEY=your-exa-api-key

# Optional: Email Service
RESEND_API_KEY=your-resend-api-key

# Configuration
NODE_ENV=development
PORT=8080
BACKEND_URL=http://localhost:8080
