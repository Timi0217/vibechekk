generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  name                 String?
  picture              String?
  githubLogin          String? // GitHub username (e.g. 'timi0217')
  tier                 SubscriptionTier @default(GUEST)
  usageCount           Int              @default(0)
  lastResetAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Referral system
  referralCode   String?   @unique @default(cuid())
  referredById   String?
  referredBy     User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("Referrals")
  bonusChekks    Int       @default(0) // Extra chekks earned from referrals
  bonusExpiresAt DateTime? // When bonus expires (for time-limited promotions)
  referralCount  Int       @default(0) // Number of successful referrals (friends who ran a chekk)

  reports          VibeReport[]
  candidate        Candidate?
  cheklistSearches CheklistSearch[]
  savedJDs         SavedJD[]
  crossChekkResults CrossChekkResult[]
}

model Candidate {
  id            String       @id @default(cuid())
  githubUrl     String       @unique
  githubHandle  String
  name          String?
  email         String?
  emailVerified Boolean      @default(false)
  claimed       Boolean      @default(false)
  userId        String?      @unique
  user          User?        @relation(fields: [userId], references: [id])
  lastEmailedAt DateTime?
  lastCheckedAt DateTime     @default(now())
  reports       VibeReport[]

  // Apollo Enrichment Data
  linkedinUrl     String?
  photoUrl        String?
  currentTitle    String?
  currentCompany  String?
  companyLogoUrl  String?
  companyLinkedin String?
  companyIndustry String?
  companySize     Int?
  location        String?
  seniority       String?
  twitterUrl      String?
  workEmail       String?
  enrichedAt      DateTime?
  enrichmentData  Json? // Full Apollo response stored for reference

  crossChekkResults CrossChekkResult[]

  @@index([githubHandle])
  @@index([email])
}

model VibeReport {
  id                String    @id @default(cuid())
  candidateId       String
  userId            String?
  guestIp           String?
  archetype         String
  tier              String    @default("COMMON")
  label             String
  trajectorySummary String
  meritPoints       Json
  confidence        Int
  repoName          String?
  metadata          Json
  createdAt         DateTime  @default(now())
  recruiterSummary  String?
  candidate         Candidate @relation(fields: [candidateId], references: [id])
  user              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([candidateId])
  @@index([createdAt])
}

model CheklistSearch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  searchType      String // "reverse" | "archetype" | "seniority" | "combined"
  reverseUsername String?
  archetype       String?
  seniority       String? // "Junior" | "Mid" | "Senior"
  languages       String[] // Array of language names
  resultCount     Int
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // Stripe event ID (evt_xxx)
  eventType String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime // TTL for cleanup (24 hours)

  @@index([eventId])
  @@index([expiresAt]) // For cleanup queries
}

model SavedJD {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String // Job title
  company     String? // Company name (optional)
  description String // Full job description text

  // Parsed requirements (extracted by JD parser)
  requiredSkills    String[] // e.g. ["React", "Node.js", "PostgreSQL"]
  niceToHaveSkills  String[] // Optional skills
  minYearsExp       Int? // Minimum years of experience
  responsibilities  String[] // Key responsibilities
  parsedData        Json? // Full parsed JD data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crossChekkResults CrossChekkResult[]

  @@index([userId, createdAt])
}

model CrossChekkResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  jdId        String
  jd          SavedJD   @relation(fields: [jdId], references: [id], onDelete: Cascade)

  // FitScore calculation
  fitScore         Int // 0-100 percentage
  recommendation   String // "SEND" or "SKIP"

  // Detailed breakdown
  skillsMatch      Json // { matched: [], missing: [], extra: [] }
  experienceMatch  Json // { candidateYears: X, requiredYears: Y, meets: true/false }
  strengthsForRole String[] // Why they're a good fit
  concernsForRole  String[] // Potential red flags

  // AI-generated summary
  aiSummary        String // Brief explanation of the fit

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([candidateId])
  @@index([jdId])
}

enum SubscriptionTier {
  GUEST
  AUTHENTICATED
  PRO
}
