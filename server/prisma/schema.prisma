generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  name                 String?
  picture              String?
  githubLogin          String?          // GitHub username (e.g. 'timi0217')
  tier                 SubscriptionTier @default(GUEST)
  usageCount           Int              @default(0)
  lastResetAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())
  stripeCustomerId     String?
  stripeSubscriptionId String?
  
  // Referral system
  referralCode         String?          @unique @default(cuid())
  referredById         String?
  referredBy           User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]           @relation("Referrals")
  bonusChekks          Int              @default(0)       // Extra chekks earned from referrals
  bonusExpiresAt       DateTime?                          // When bonus expires (for time-limited promotions)
  referralCount        Int              @default(0)       // Number of successful referrals (friends who ran a chekk)
  
  reports              VibeReport[]
}

model Candidate {
  id            String       @id @default(cuid())
  githubUrl     String       @unique
  githubHandle  String
  lastCheckedAt DateTime     @default(now())
  reports       VibeReport[]
}

model VibeReport {
  id                String    @id @default(cuid())
  candidateId       String
  userId            String?
  guestIp           String?
  archetype         String
  tier              String    @default("COMMON")
  label             String
  trajectorySummary String
  meritPoints       Json
  confidence        Int
  repoName          String?
  metadata          Json
  createdAt         DateTime  @default(now())
  recruiterSummary  String?
  candidate         Candidate @relation(fields: [candidateId], references: [id])
  user              User?     @relation(fields: [userId], references: [id])
}

enum SubscriptionTier {
  GUEST
  AUTHENTICATED
  PRO
}
